# Every setting has a default, so the project runs without a .env file.
# To change one, copy this file to .env and edit the value. The project needs no secret.

# The port the server listens on. In development Vite proxies /api to it.
PORT=3000

# The folder that holds manifest.json and the docx, pdf and txt of every edition.
DATA_DIR=data/sample

# The two below are read by the scripts only (npm run fetch-sample, npm run convert).

# The site the sample is downloaded from.
TAKAM_BASE_URL=https://takam.mof.gov.il

# The LibreOffice program. Give its full path when it is not on the PATH.
SOFFICE_PATH=soffice
